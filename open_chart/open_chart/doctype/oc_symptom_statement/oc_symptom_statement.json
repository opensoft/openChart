{
 "doctype": "DocType",
 "name": "OC Symptom Statement",
 "module": "Open Chart",
 "custom": 0,
 "engine": "InnoDB",
 "naming_rule": "Expression",
 "autoname": "format:OC-SYMST-{#####}",
 "field_order": [
  "patient",
  "submission",
  "assertion_kind",
  "source_entry_id",
  "reported_text",
  "verification_state",
  "predecessor",
  "amendment_reason",
  "code_system",
  "code_value",
  "code_display",
  "onset_reported",
  "severity_reported",
  "confidence_reported"
 ],
 "fields": [
