   "label": "Assertion Kind",
   "reqd": 1,
   "default": "patient_reported",
   "read_only": 1
  },
  {
   "fieldname": "source_entry_id",
   "fieldtype": "Data",
   "label": "Source Entry Id",
   "reqd": 1
  },
  {
   "fieldname": "reported_text",
   "fieldtype": "Small Text",
   "label": "Reported Text",
   "reqd": 1
  },
  {
   "fieldname": "verification_state",
