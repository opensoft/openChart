  },
  {
   "fieldname": "amendment_reason",
   "fieldtype": "Small Text",
   "label": "Amendment Reason"
  },
  {
   "fieldname": "code_system",
   "fieldtype": "Data",
   "label": "Code System"
  },
  {
   "fieldname": "code_value",
   "fieldtype": "Data",
   "label": "Code Value"
  },
  {
   "fieldname": "code_display",
   "fieldtype": "Data",
   "label": "Code Display"
  },
  {
   "fieldname": "onset_reported",
   "fieldtype": "Data",
   "label": "Onset Reported"
  },
  {
   "fieldname": "severity_reported",
   "fieldtype": "Data",
   "label": "Severity Reported"
  },
  {
   "fieldname": "confidence_reported",
   "fieldtype": "Data",
   "label": "Confidence Reported"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
